              }
            ],
            "dataType": "double",
            "isHidden": true,
            "lineageTag": "6a9e9d6c-0e6c-59d2-be93-7744566b2fb0",
            "sourceColumn": "duration_minutes",
            "summarizeBy": "sum"
          }
        ],
        "lineageTag": "660ea139-4c23-5d84-92cf-c311d5c5833b",
        "measures": [
          {
            "name": "Total Rides",
            "expression": "SUM(Trips[Ride count])",
            "formatString": "#,0",
            "lineageTag": "ceed57a6-e4bc-55d7-81d4-98823f853de0"
          },
          {
            "name": "Average Ride Minutes",
            "expression": "DIVIDE(SUM(Trips[Duration minutes]), [Total Rides])",
            "formatString": "0.0",
            "lineageTag": "cf2c9b27-9a07-57b8-86b8-5b35384853ce"
          },
          {
            "name": "Casual Rides",
            "expression": "CALCULATE([Total Rides], Rider[Rider] = \"Casual\")",
            "formatString": "#,0",
            "lineageTag": "6373d8b5-36de-5427-9c3c-6c4ed9e97eeb"
          },
          {
            "name": "Member Rides",
            "expression": "CALCULATE([Total Rides], Rider[Rider] = \"Member\")",
            "formatString": "#,0",
            "lineageTag": "07087181-153d-5254-834e-56fa9f4995b3"
          },
          {
            "name": "Casual Ride Share",
            "expression": "DIVIDE([Casual Rides], CALCULATE([Total Rides], REMOVEFILTERS(Rider)))",
            "formatString": "0.0%",
            "lineageTag": "9f778f7f-9b73-5245-a62d-4dc8c505e953"
          },
          {
            "name": "Weekend Ride Share",
            "expression": "DIVIDE(COALESCE(CALCULATE([Total Rides], KEEPFILTERS(Trips[Day type] = \"Weekend\")), 0), [Total Rides])",
            "formatString": "0.0%",
            "lineageTag": "d9e7a221-858b-51a4-b2d9-5c9111220531"
          },
          {
            "name": "Hourly Ride Share",
            "expression": "DIVIDE([Total Rides], CALCULATE([Total Rides], REMOVEFILTERS(Trips[Hour])))",
            "formatString": "0.0%",
            "lineageTag": "b143c0fc-0105-5517-b5a7-6c9a94238aaf"
          },
          {
            "name": "Station Rides",
            "expression": "SUM(Stations[Ride count])",
            "formatString": "#,0",
            "lineageTag": "918902cf-c9a3-585e-955f-93d719bedb85"
          },
          {
            "name": "Casual Station Rides",
            "expression": "CALCULATE([Station Rides], Rider[Rider] = \"Casual\")",
            "formatString": "#,0",
            "lineageTag": "ab20fdcd-47a1-5eee-882c-0c7174fde63f"
          },
          {
            "name": "Known Casual Station Share",
            "expression": "DIVIDE(CALCULATE([Casual Station Rides], Stations[Start station] <> \"Unknown station\"), [Casual Station Rides])",
            "formatString": "0.0%",
            "lineageTag": "e20d977d-de39-51fe-b9dd-872b9b85ac24"
          },
          {
            "name": "Top 10 Casual Station Rides",
            "expression": [
              "VAR KnownStations = FILTER(ALLSELECTED(Stations[Start station]), Stations[Start station] <> \"Unknown station\")",
              "VAR TopStations = TOPN(10, KnownStations, [Casual Station Rides], DESC, Stations[Start station], ASC)",
              "RETURN IF(CONTAINS(TopStations, Stations[Start station], SELECTEDVALUE(Stations[Start station])), [Casual Station Rides])"
            ],
            "formatString": "#,0",
            "lineageTag": "f86d343f-edcb-5eb9-9aab-dd3cb9bc346d"
          },
          {
            "name": "Source Rides",
            "expression": "SUM(Quality[Source rides])",
            "formatString": "#,0",
            "lineageTag": "277258e9-2b29-5fe3-8794-1ff658af02e7"
          },
          {
            "name": "Removed Rides",
            "expression": "SUM(Quality[Source rides]) - SUM(Quality[Clean rides])",
            "formatString": "#,0",
            "lineageTag": "0157789a-1771-59f0-addf-3c53b4758f9f"
          },
          {
            "name": "Retained Ride Share",
            "expression": "DIVIDE(SUM(Quality[Clean rides]), [Source Rides])",
            "formatString": "0.0%",
            "lineageTag": "b0b2cf46-2e41-5596-adb1-5b5bf7f641b4"
          }
        ],
        "partitions": [
          {
            "name": "Trips",
